{
  "name": "devupai",
  "version": "4.0.0",
  "description": "Official Node.js SDK for the DEVUP AI platform: an OpenAI-compatible API with DZD billing.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./ai": {
      "import": {
        "types": "./dist/provider.d.mts",
        "default": "./dist/provider.mjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "devupai",
    "ai",
    "llm",
    "inference",
    "embeddings",
    "openai-compatible",
    "algeria",
    "dzd",
    "vercel-ai-sdk"
  ],
  "author": "DEVUP AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devupai-platform/devupai-node.git"
  },
  "homepage": "https://github.com/devupai-platform/devupai-node#readme",
  "bugs": {
    "url": "https://github.com/devupai-platform/devupai-node/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@ai-sdk/openai-compatible": ">=3.0.0 <4.0.0",
    "@ai-sdk/provider": ">=4.0.0 <5.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "@ai-sdk/provider": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsup",
    "prepack": "npm run build",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "sync:spec": "node scripts/sync-spec.mjs",
    "generate:types": "node scripts/generate-types.mjs",
    "check:types": "node scripts/check-types.mjs"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.82",
    "@ai-sdk/provider": "^4.0.35",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "ai": "^7.0.159",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "devupai-published": "npm:devupai@2.1.3",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "js-yaml": "^5.5.0",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^2.0.0"
  }
}
