{
  "name": "devupai",
  "version": "3.2.0",
  "description": "Official Node.js SDK for DEVUP AI — OpenAI-compatible inference gateway with DZD billing",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./ai": {
      "import": {
        "types": "./dist/provider.d.mts",
        "default": "./dist/provider.mjs"
      },
      "require": {
        "types": "./dist/provider.d.ts",
        "default": "./dist/provider.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "devupai",
    "ai",
    "llm",
    "inference",
    "embeddings",
    "openai-compatible",
    "algeria",
    "dzd",
    "vercel-ai-sdk"
  ],
  "author": "DEVUP AI",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@ai-sdk/openai-compatible": ">=2.0.0 <3.0.0",
    "@ai-sdk/provider": ">=3.0.0 <4.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "@ai-sdk/provider": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate:provenance": "node scripts/generate-openapi-provenance.mjs"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^2.0.50",
    "@ai-sdk/provider": "^3.0.10",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "devupai-published": "npm:devupai@2.1.3",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^2.0.0"
  }
}
